{
  "name": "react-halftone",
  "version": "1.0.0",
  "description": "Convert images into halftone effects (mono + CMYK) in the browser, in realtime",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    },
    "./core": {
      "import": { "types": "./dist/core/index.d.mts", "default": "./dist/core/index.mjs" },
      "require": { "types": "./dist/core/index.d.ts", "default": "./dist/core/index.js" }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.3.7",
    "canvas": "^3.2.1",
    "jsdom": "^27.4.0",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "license": "MIT"
}
